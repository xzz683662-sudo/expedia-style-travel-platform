# ---------------------------------------------------------------------------
# Voyahub environment
# Copy to .env at the repo root. docker-compose reads the same values.
# ---------------------------------------------------------------------------

# --- Core database -----------------------------------------------------------
# Hosted / managed Postgres (recommended for anything beyond local dev)
# DATABASE_URL="postgresql://easytrip:easytrip@localhost:5432/easytrip?schema=public"
# Local dev via docker compose:
DATABASE_URL="postgresql://easytrip:easytrip@localhost:5432/easytrip?schema=public"

# --- Redis (inventory hot-path cache, rate limiting, idempotency locks) ------
REDIS_URL="redis://localhost:6379"

# --- OpenSearch / Elasticsearch (search & sorting) --------------------------
# EMPTY BY DEFAULT, and that is deliberate. OpenSearch is behind
# `profiles: ["search"]` in docker-compose, so it is not running unless you ask
# for it — yet a non-empty value here makes every single search request try
# 9200, fail, and fall back to Postgres (`search.opensearch_failed_falling_back`
# in the logs). One wasted network round-trip per request, for a service that
# is not there.
#
# The built-in Postgres search is the supported path and handles the whole
# catalogue; see docs/search-index-design.md for the measurements and for why
# no search engine is warranted at this data size. Run `pnpm db:indexes` to add
# the trigram indexes that keep it fast as the catalogue grows.
OPENSEARCH_NODE=""
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""

# --- Object storage (ticket PDFs, voucher images, merchant media) -----------
# S3 / MinIO compatible. Falls back to local disk when empty.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="voyahub-tickets"
S3_ACCESS_KEY_ID="voyahub"
S3_SECRET_ACCESS_KEY="voyahub-secret"
S3_FORCE_PATH_STYLE="true"

# --- Payments (Hyperswitch-compatible router) ------------------------------
# The platform ships a deterministic mock gateway so the whole booking ->
# pay -> issue -> redeem -> refund loop is testable without provider accounts.
PAYMENT_PROVIDER="mock"
HYPERSWITCH_BASE_URL=""
HYPERSWITCH_API_KEY=""
PAYMENT_WEBHOOK_SECRET="whsec_dev_change_me"

# --- Additional settlement rails (modelled, SANDBOX-ONLY this stage) --------
# PayPal and TRC20 are classed SETTLEMENT, and this stage's credential boundary
# admits no live settlement credential (see modules/supply/credentials.ts and
# docs/supply-sources.md). Both run deterministically in `sandbox` and REFUSE
# `live` outright, so a stray value here cannot move real money.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# TRC20 needs a receiving address even in sandbox; without one the rail is inert
# (an explicit failure, never a silent no-op). Addresses are checksum-validated.
TRC20_MODE="sandbox"
TRC20_RECEIVING_ADDRESS=""
TRC20_NETWORK="tron"
TRC20_CONFIRMATIONS=19

# --- Booking engine ---------------------------------------------------------
# Minutes a seat/slot stays held in PENDING before auto-release.
INVENTORY_HOLD_MINUTES=15
CURRENCY_DEFAULT="USD"
MARKUP_BPS="1200"
PLATFORM_FEE_BPS="1200"
TAX_BPS="800"
CHECKOUT_TOKEN_TTL_MINUTES=20
# --- Real-time supply layer (see docs/realtime-supply-plan.md) -------------
# Off by default, and that is a correctness requirement, not caution: every
# consumer falls back to TicketType.basePriceCents while this is off, so the
# platform behaves exactly as it did before. Turn it on only once a real
# source is configured in apps/api/src/modules/supply/live-adapters.ts.
SUPPLY_LIVE_ENABLED=false
# TTLs are ordered by how much a stale answer costs. Search may be minutes old
# (a shopper is still browsing); availability should not be. Checkout ignores
# all of these and revalidates against live state — see modules/supply/live.ts.
SUPPLY_LIVE_SEARCH_TTL=300
SUPPLY_LIVE_DETAIL_TTL=60
SUPPLY_LIVE_AVAILABILITY_TTL=30
# Comma-separated allow-list of image hosts whose URLs may be written to
# ProductMedia.url. An allow-list, not a proxy: next.config.ts needs a matching
# remotePatterns entry either way, and a generic ?url= image proxy would be an
# SSRF hole for no gain.
SUPPLY_LIVE_IMAGE_HOSTS=""
# Per-provider credentials for the live rate chain. An adapter with no key
# returns no data, which the resolver treats as "this source carries no data"
# rather than as an error — so leaving these blank is safe and keeps search on
# the seeded prices. Both were verified against the live upstream on 2026-10-05;
# see docs/supply-sources.md.
# Kiwi Tequila: partner registration by email magic link at tequila.kiwi.com.
KIWI_API_KEY=""
KIWI_BASE_URL="https://tequila-api.kiwi.com"
# SerpApi: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=""
SERPAPI_BASE_URL="https://serpapi.com"

# trvl — zero-key Go binary that returns real flight and hotel prices.
# https://github.com/MikkoParkkola/trvl/releases
#
# Requires a business decision before enabling. The binary is MIT, but it reads
# Google Flights and Google Hotels, and its own README says automated access
# "may violate some providers' Terms of Service — you are responsible for
# compliance in your jurisdiction". Nothing in this repo's licensing covers
# that, so it stays off until you have decided.
#
# It is a PRE-WARM source, never inline: one invocation measured 24.6 s, so a
# background loop calls it and the adapter reads Redis. A cache miss means the
# shopper sees the seeded price, which is the intended degradation.
#
# trvl ignores `--currency` and always answers in EUR (measured against USD,
# GBP, AUD and JPY — identical prices every time). The EUR it returns is stored
# as-is and converted to the platform's settlement currency by `utils/fx` on the
# way out of `pickOffer`, so one warmed route serves the whole catalogue.
TRVL_ENABLED=false
TRVL_BINARY_PATH=""
TRVL_WARM_TTL=900
TRVL_TIMEOUT_MS=90000

# --- FX (upstream rate -> the currency the platform sells in) ---------------
# Needed because upstreams answer in their own currency (trvl is EUR-only and
# ignores --currency; Kiwi answers the seller's). `pickOffer` converts on the
# way out so the quote always matches `TicketType.currency`, while
# `computeQuote` keeps doing no FX of its own.
#
# This is a *display/compare* conversion only. Stored prices are never
# rewritten and settlement is still in `TicketType.currency` — see utils/fx.ts
# for why rewriting `basePriceCents` would corrupt the price a previous order
# was priced against.
#
# Default is free, key-less, and covers all 8 currencies in the catalogue.
# A rate-provider outage makes the conversion return null, which leaves the
# seeded price untouched rather than inventing an identity rate.
FX_BASE_URL="https://open.er-api.com/v6/latest"
FX_TIMEOUT_MS=8000

# --- App --------------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
# Leave empty: the browser calls the storefront's own origin, and Next proxies
# /api/v1, /media and /health to the API (see apps/web/next.config.ts). Set this
# only when the API lives on a separate origin, which re-introduces CORS.
NEXT_PUBLIC_API_BASE_URL=""
# Server-side API origin used by SSR and by the proxy above.
API_INTERNAL_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
JWT_SECRET="dev_jwt_secret_change_me"
JWT_EXPIRES_IN="7d"

# --- Inventory feed (Apify Expedia Hotels) ----------------------------------
# Third-party hotel rows, staged and NEVER sold. A row becomes sellable only
# after an operator promotes it by hand into a first-party product (positioning
# option A — see docs/adr/0001-inventory-feed-positioning.md). The ingest job
# writes only `ScrapedInventory`; it never touches Product / TicketType /
# InventoryRecord, which is what keeps a scraper bug from becoming a pricing bug.
#
# OFF BY DEFAULT. With the flag off, the /admin/inventory-feed routes 404 and no
# scheduler starts — the platform behaves exactly as before.
INVENTORY_FEED_ENABLED=false
# Apify API token: https://console.apify.com/settings/integrations
# Leave empty to disable. NEVER commit a real token.
APIFY_TOKEN=""
APIFY_HOTEL_ACTOR="jupri/expedia-hotels"
# Portal id selecting the actor's region AND currency. "1" = Expedia US (USD),
# which matches the platform's settlement currency. The actor validates this as
# a numeric id — a hostname like "expedia.com" is rejected.
APIFY_HOTEL_SITE="1"
APIFY_HOTEL_LANGUAGE="en_US"
# Extra data blocks to request, comma-separated (offers,location,amenities,
# review,calendar,availability,...). Empty is cheapest; each block costs
# upstream traffic, and this actor's reliability is the constraint.
APIFY_HOTEL_INCLUDES=""
# OPTIONAL escape hatch. The actor's default egress is Apify's *shared*
# residential proxy group, which Expedia rate-limits across every user — probed
# runs fail with `HTTP 429 Too Many Requests` through
# `<http://groups-RESIDENTIAL@…> (REQUIRED)`. Supply your own proxy here as the
# actor's `dev_proxy_config` JSON object to bypass that shared pool. It is a
# passthrough (this code does not guess the object's fields):
#   APIFY_HOTEL_PROXY_CONFIG='{"useApifyProxy":false,"proxyUrls":["socks5://host:9000"]}'
APIFY_HOTEL_PROXY_CONFIG=""
# A run is billed per platform usage; an unbounded batch is a bill, not a job.
INVENTORY_FEED_MAX_ROWS=500
INVENTORY_FEED_RUN_TIMEOUT_MS=900000
INVENTORY_FEED_POLL_MS=5000
INVENTORY_FEED_STALE_HOURS=48
