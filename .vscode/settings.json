{
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "editor.experimental.preferTreeSitter.css": true,
    "editor.experimental.preferTreeSitter.typescript": true,
    "editor.experimental.treeSitterTelemetry": true,
    "workbench.experimental.share.enabled": true,
    "chat.mcp.assisted.nuget.enabled": true,
    "github.copilot.chat.completionsFetcher": "electron-fetch",
    "github.copilot.chat.exploreAgent.enabled": true,
    "github.copilot.chat.nesFetcher": "electron-fetch",
    "github.copilot.chat.switchAgent.enabled": true,
    "python.analysis.supportDocstringTemplate": true,
    "chat.defaultToCopilotHarness": true,
    "chat.copilotHarnessIntroduction.mode": "off",
    "chat.customizations.marketplace.enabled": true,
    "chat.customizations.locationsMigration.enabled": true,
    "chat.experimental.collectInstructionsInExtension": true,
    "dictation.showButton": false,
    "dictation.model": "nemotron-3.5-asr-streaming-0.6b",
    "dictation.showTranscript": false,
    "dictation.experimental.llmCleanup": false,
    "js/ts.experimental.useTsgo": false,
    "markdown.validate.enabled": true,
    "chat.mcp.serverSampling": {
        "expedia-style-travel-platform/.mcp.json: microsoft/markitdown": {
            "allowedModels": [
    
            ]
        },
        "expedia-style-travel-platform/.vscode/mcp.json: microsoft/markitdown": {
            "allowedModels": []
        }
    },
    "prisma.pinToPrisma6": true,
    // This repo's SQL is PostgreSQL (Prisma), not T-SQL. The MSSQL extension
    // otherwise lints every `.sql` file with a SQL Server parser and flags
    // valid PG syntax as errors (`create extension if not exists`,
    // `create or replace function … as $$ … $$`, `using gin (… gin_trgm_ops)`,
    // `::regdictionary`, `$1`). There is no T-SQL in this repo, so turning its
    // error checking off is safe and is the switch that actually silences it.
    "mssql.intelliSense.enableErrorChecking": false,
    "mssql.autoDisableNonTSqlLanguageService": true
}
