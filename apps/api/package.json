{
  "name": "@easytrip/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "supply:import": "tsx prisma/supply-import.ts",
    "supply:probe": "tsx prisma/live-rate-probe.ts",
    "supply:contract": "tsx prisma/live-contract-check.ts",
    "inventory:contract": "tsx prisma/inventory-feed-check.ts",
    "inventory:integration": "tsx prisma/inventory-feed-integration.ts",
    "inventory:fixture": "tsx prisma/inventory-feed-fixture.ts",
    "inventory:index": "tsx prisma/inventory-feed-index-check.ts",
    "credentials:contract": "tsx prisma/credentials-check.ts",
    "account:integration": "tsx prisma/account-integration.ts",
    "db:indexes": "tsx prisma/apply-indexes.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^5.22.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.8",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
