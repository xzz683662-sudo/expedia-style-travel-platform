.DS_Store
apps/api/prisma/dev.db
apps/web/.vercel
.turbo/
apps/web/tsconfig.tsbuildinfo

# Ticket artefacts are regenerated by the ticketing run; committing them just
# grows the repo and churns the diff on every smoke test.
/apps/api/storage/tickets/

# The workspace is pnpm (see pnpm-lock.yaml). A stray package-lock.json is
# almost always an accidental `npm install` and must never be committed, or the
# two lockfiles disagree and installs become non-reproducible.
/package-lock.json

# Local Python virtualenv (this workspace is TypeScript/pnpm; never commit it).
/.venv/

# Browser-audit output. Screenshots are regenerated by `pnpm ux:audit:*`, so
# they are build products rather than sources — the Markdown reports under
# docs/ are the part worth reviewing and committing.
/artifacts/
/test-results/
/playwright-report/
